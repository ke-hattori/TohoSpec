/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 120, 72
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Terminator"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Terminator Version 1.0",IDC_STATIC,24,10,73,8,
                    SS_NOPREFIX
    LTEXT           "Copyright (C) 2005",IDC_STATIC,31,25,59,8
    DEFPUSHBUTTON   "OK",IDOK,33,44,50,14,WS_GROUP
END

IDD_TERMINATOR_DIALOG DIALOGEX 0, 0, 171, 306
STYLE DS_MODALFRAME | DS_SETFOREGROUND | DS_3DLOOK | WS_MINIMIZEBOX | 
    WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Terminator"
FONT 8, "MS Sans Serif"
BEGIN
    PUSHBUTTON      "ForceRestart",IDC_BUTTON1,3,282,50,15,BS_CENTER | 
                    BS_VCENTER | BS_FLAT,WS_EX_STATICEDGE
    PUSHBUTTON      "ForceKill",IDC_BUTTON2,56,282,35,15,BS_FLAT,
                    WS_EX_STATICEDGE
    PUSHBUTTON      "AgentCD",IDC_BUTTON3,94,282,35,15,BS_FLAT | NOT 
                    WS_VISIBLE | WS_DISABLED,WS_EX_STATICEDGE
    PUSHBUTTON      "Close",IDCANCEL,134,282,34,15,BS_CENTER | BS_TOP | 
                    BS_FLAT | NOT WS_TABSTOP,WS_EX_STATICEDGE
    DEFPUSHBUTTON   "OK",IDOK,0,264,20,9,NOT WS_VISIBLE | NOT WS_TABSTOP
    CONTROL         "List1",IDC_LIST1,"SysListView32",LVS_REPORT | 
                    LVS_SHOWSELALWAYS | LVS_AUTOARRANGE | LVS_ALIGNLEFT | 
                    WS_BORDER | WS_TABSTOP,0,0,171,274,WS_EX_CLIENTEDGE
    PUSHBUTTON      "Restart",IDC_BUTTON4,0,272,32,10,NOT WS_VISIBLE
END

IDD_RESTART DIALOG DISCARDABLE  0, 0, 162, 73
STYLE DS_MODALFRAME | DS_SETFOREGROUND | DS_3DLOOK | DS_CENTER | 
    DS_CENTERMOUSE | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "System Error"
FONT 9, "MS Sans Serif"
BEGIN
    COMBOBOX        IDC_COMBO1,10,20,140,87,CBS_DROPDOWNLIST | WS_VSCROLL | 
                    WS_TABSTOP
    DEFPUSHBUTTON   "OK",IDOK,55,55,50,15
    PUSHBUTTON      "Cancel",IDCANCEL,0,0,6,6,NOT WS_VISIBLE
    LTEXT           "What do you want the computer to do ?",IDC_STATIC,10,40,
                    138,10,SS_CENTERIMAGE
    LTEXT           "Reboot computer to restore system.",IDC_STATIC_MSG,10,5,
                    140,12,SS_CENTERIMAGE
END


