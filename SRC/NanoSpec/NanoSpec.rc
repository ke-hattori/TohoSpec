/////////////////////////////////////////////////////////////////////////////
//
// Cursor
//

IDC_CROSS_1             CURSOR  DISCARDABLE     "res\\Cross_1.cur"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_DATA_MENU MENU DISCARDABLE 
BEGIN
    POPUP "モード(&M)"
    BEGIN
        MENUITEM "測定(&M)",                    IDM_MEASUREMENT
        MENUITEM "レシピ編集(&R)",              IDM_RECIPE_SETTING
        MENUITEM "データ(&D)",                  IDM_DATA
        MENUITEM "アラーム(&A)",                IDM_ALARM
        MENUITEM "ログオン(&L)",                IDM_LOGON
        MENUITEM SEPARATOR
        MENUITEM "ユーザ設定(&U)",              IDM_USER_SETTING
        MENUITEM "システムチェック(&C)",        IDM_MAINTENANCE
        MENUITEM "システム設定(&S)",            IDM_SYSTEM
        MENUITEM SEPARATOR
        MENUITEM "終了(&Q)",                    ID_APP_EXIT
    END
    POPUP "操作(&O)"
    BEGIN
        MENUITEM "&Review",                     IDM_REVIEW
        MENUITEM "データ検索(&S)",              IDM_SEARCH
        MENUITEM "データ削除(&D)",              IDM_DELETE
        MENUITEM SEPARATOR
        MENUITEM "インポート(&I)",              IDM_IMPORT
        MENUITEM "エクスポート(&E)",            IDM_EXPORT
        MENUITEM SEPARATOR
        MENUITEM "印刷(&P)",                    IDM_PRINT
    END
    POPUP "ヘルプ(&H)"
    BEGIN
        MENUITEM "バージョン情報(&A)",          ID_APP_ABOUT
    END
END

IDR_EDIT_RECIPE_MENU MENU DISCARDABLE 
BEGIN
    POPUP "モード(&M)"
    BEGIN
        MENUITEM "測定(&M)",                    IDM_MEASUREMENT
        MENUITEM "レシピ編集(&R)",              IDM_RECIPE_SETTING
        MENUITEM "データ(&D)",                  IDM_DATA
        MENUITEM "アラーム(&A)",                IDM_ALARM
        MENUITEM "ログオン(&L)",                IDM_LOGON
        MENUITEM SEPARATOR
        MENUITEM "ユーザ設定(&U)",              IDM_USER_SETTING
        MENUITEM "システムチェック(&C)",        IDM_MAINTENANCE
        MENUITEM "システム設定(&S)",            IDM_SYSTEM
        MENUITEM SEPARATOR
        MENUITEM "終了(&Q)",                    ID_APP_EXIT
    END
    POPUP "操作(&O)"
    BEGIN
        MENUITEM "上書き保存(&S)",              IDM_SAVE
        MENUITEM "名前を付けて保存(&A)",        IDM_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "閉じる(&E）",                 IDM_EXIT
    END
    POPUP "ヘルプ(&H)"
    BEGIN
        MENUITEM "バージョン情報(&A)",          ID_APP_ABOUT
    END
END

IDR_MAINFRAME MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "ﾌｧｲﾙ(&F)"
    BEGIN
        MENUITEM "新規作成(&N)\tCtrl+N",        ID_FILE_NEW
        MENUITEM "開く(&O)...\tCtrl+O",         ID_FILE_OPEN
        MENUITEM "上書き保存(&S)\tCtrl+S",      ID_FILE_SAVE
        MENUITEM "名前を付けて保存(&A)...",     ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "印刷(&P)...\tCtrl+P",         ID_FILE_PRINT
        MENUITEM "印刷ﾌﾟﾚﾋﾞｭｰ(&V)",             ID_FILE_PRINT_PREVIEW
        MENUITEM "ﾌﾟﾘﾝﾀの設定(&R)...",          ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "最近使ったﾌｧｲﾙ",              ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
