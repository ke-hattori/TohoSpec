long GetNtPtaError()
{
/* added 2011.11.11 hmenjo [‚R]PORT_NT”r‘¼ ---------- { ---------- */
	::WaitForSingleObject(g_hmutexPORT_NT, INFINITE);
/* added 2011.11.11 hmenjo [‚R]PORT_NT”r‘¼ ---------- } ---------- */
long rc;

	rc = ( long )GetLastError();
	switch ( rc ){
	case ERROR_INVALID_FUNCTION:
		rc = -12;
		break;
	case ERROR_INVALID_PARAMETER:
		rc = -2;
		break;
	case ERROR_NOACCESS:
		rc = -3;
		break;
	case NO_ERROR:
		rc = SetIOError;
		break;
	}
	SetIOError = 0;

/* added 2011.11.11 hmenjo [‚R]PORT_NT”r‘¼ ---------- { ---------- */
	::ReleaseMutex(g_hmutexPORT_NT);
/* added 2011.11.11 hmenjo [‚R]PORT_NT”r‘¼ ---------- } ---------- */
	return rc;
}
