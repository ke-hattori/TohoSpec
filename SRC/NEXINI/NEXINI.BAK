TProfileData<NEXINIPARAMS> profile(NexIniTable, NEXINI_INIFILE_NAME, FALSE);
/* added 2009.07.07 hmenjo dll 相対パス対応 nexini.dll ---------- { ---------- */
TCHAR g_tszProcDir[_MAX_PATH] = _T("");		/* 呼出しプロセスのディレクトリ('\'付き)*/
/* added 2009.07.07 hmenjo dll 相対パス対応 nexini.dll ---------- } ---------- */

// ===========================================================================
// NEXADAX local helper function declarations
// ===========================================================================

BOOL APIENTRY DllMain( HANDLE hModule,
					   DWORD  ul_reason_for_call,
					   LPVOID lpReserved
					 )
{
	switch ( ul_reason_for_call ) {
	case DLL_PROCESS_ATTACH:
/* added 2009.07.07 hmenjo dll 相対パス対応 nexini.dll ---------- { ---------- */
		if (0 == _tcscmp(g_tszProcDir, _T(""))) {
			TCHAR l_tszProcessFName[_MAX_PATH];	/* 呼出しプロセスのフルパス*/
			::GetModuleFileName(0, l_tszProcessFName, sizeof(l_tszProcessFName));
			TCHAR l_tszDrive[_MAX_DRIVE];
			TCHAR l_tszDir[_MAX_DIR];
			_tsplitpath(l_tszProcessFName, l_tszDrive, l_tszDir, 0, 0);
			_stprintf(g_tszProcDir, _T("%s%s"), l_tszDrive, l_tszDir);
			if (0 != _tcslen(g_tszProcDir)) {
				if (_T('\\') != g_tszProcDir[_tcslen(g_tszProcDir) - 1]) {
					_tcscat(g_tszProcDir, _T("\\"));
				}
			}
		}
		TCHAR l_tszIniPath[_MAX_PATH];
		_stprintf(l_tszIniPath, _T("%s") _T(NEXINI_INIFILE_NAME), g_tszProcDir);
		profile.SetFilePath(l_tszIniPath);
		profile.Get();
/* added 2009.07.07 hmenjo dll 相対パス対応 nexini.dll ---------- } ---------- */
		break;
	case DLL_THREAD_ATTACH:
		break;
	case DLL_THREAD_DETACH:
		break;
	case DLL_PROCESS_DETACH:
		break;
	}
	return TRUE;
}

// ---------------------------------------------------------------------------
// nexiniGetParameter
// ---------------------------------------------------------------------------
NEXINIAPI void __stdcall nexiniGetParameter(PNEXINIPARAMS pParams)
{
	basic_interface::copymemory(pParams, &profile);
}

// ---------------------------------------------------------------------------
// nexiniSetParameter
// ---------------------------------------------------------------------------
NEXINIAPI void __stdcall nexiniSetParameter(PNEXINIPARAMS pParams)
{
	if ( pParams != NULL )
		basic_interface::copymemory(&profile, pParams);

	profile.Write();
}
