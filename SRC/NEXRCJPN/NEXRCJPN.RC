                    BS_AUTOCHECKBOX | WS_TABSTOP,5,400,65,10
    CONTROL         "マニュアル出力",IDC_MANUAL_OUTPUT,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,80,400,65,10
